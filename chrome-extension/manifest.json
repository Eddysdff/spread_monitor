{
  "manifest_version": 3,
  "name": "PerpDEX 套利监控",
  "version": "1.0.0",
  "description": "监控多个PerpDEX的价差，生成套利信号",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://zo-mainnet.n1.xyz/*",
    "https://gateway.prod.nado.xyz/*",
    "https://omni.variational.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
